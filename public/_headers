# Cloudflare Pages response headers. Format: a path, then indented "Name: value" lines.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite fingerprints these file names, so a changed file always gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keeps the PDF out of search results; people find the site instead.
/Junchen_Xiong_Resume.pdf
  X-Robots-Tag: noindex
