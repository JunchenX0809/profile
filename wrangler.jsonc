// Cloudflare Workers hosting. Cloudflare's build runs `npm run build`, then
// `npx wrangler deploy` on main and `npx wrangler preview` on other branches.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "junchenxiong",
  "compatibility_date": "2026-11-09",

  // A static site: no Worker script, Cloudflare serves the files in dist/.
  // _headers in dist/ applies as on Pages; unknown paths get dist/404.html with status 404.
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page"
  },

  "routes": [{ "pattern": "junchenxiong.com", "custom_domain": true }],

  // workers.dev address for testing; branch previews live there too and are sent
  // with X-Robots-Tag: noindex.
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
